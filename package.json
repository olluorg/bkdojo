{
  "name": "bkdojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Backend Interview Trainer — adaptive Java/Kotlin backend interview prep (Chrome-first MVP)",
  "scripts": {
    "dev": "vite",
    "dev:api": "bun server/dev.ts",
