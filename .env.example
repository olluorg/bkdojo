# Server-side AI evaluation via OpenRouter (optional).
# Copy to .env and fill in. The key stays on the server — never in the client bundle.

# Required for the eval function (api/evaluate.ts):
OPENROUTER_API_KEY=

# Optional: model to use (OpenRouter model id). Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: override the API URL (e.g. an OpenAI-compatible gateway/proxy).
# Base URL — "/chat/completions" is appended. Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Or set the FULL completions URL to bypass the base entirely (takes precedence):
# OPENROUTER_URL=https://your-gateway.example.com/v1/chat/completions

# Optional: ask the provider for structured JSON output (response_format json_schema).
# OFF by default — it's fragile across OpenRouter providers, and we already demand
# strict JSON in the prompt and validate it ourselves. Enable only if your provider
# supports it: OPENROUTER_STRUCTURED_OUTPUTS=1
OPENROUTER_STRUCTURED_OUTPUTS=

# Optional: attribution + CORS
OPENROUTER_REFERER=
ALLOWED_ORIGIN=

# Client (Vite, build-time): enable the server evaluator by pointing at the endpoint.
# Empty/unset = server evaluator disabled (Chrome AI → manual only).
VITE_EVAL_ENDPOINT=/api/evaluate

# ── Cross-device progress sync via the @ollu micro-platform (opt-in) ──────────
# Off by default: without VITE_BKDOJO_SYNC=1 the app stays local-first with no
# auth, and the sync SDK is never imported into the bundle.
# VITE_BKDOJO_SYNC=1

# Sync server URL (overridable per-user later). Default: http://localhost:8080
# VITE_OLLU_SERVER=https://api.ollu.example.com

# Google OAuth Web client ID for login. Register an "OAuth 2.0 Client ID"
# (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add this app's origin (plus http://localhost:5173) to authorised origins
# and redirect URIs. Leave empty to disable Google auth (sync stays offline-only).
# VITE_OLLU_GOOGLE_CLIENT_ID=
