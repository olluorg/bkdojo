# Server-side AI evaluation now runs against the micro-platform LLM proxy
# (/functions/llm) with the user's OWN OpenRouter key, entered in the app's
# Settings screen. bkdojo no longer holds any provider key — there are no
# OPENROUTER_* secrets here anymore.

# Client (Vite, build-time): enable the server evaluator by pointing at the proxy.
# Empty/unset = server evaluator disabled (Chrome AI → manual only).
VITE_EVAL_ENDPOINT=http://localhost:8080/functions/llm

# ── Cross-device progress sync via the @ollu micro-platform (opt-in) ──────────
# Off by default: without VITE_BKDOJO_SYNC=1 the app stays local-first with no
# auth, and the sync SDK is never imported into the bundle.
# VITE_BKDOJO_SYNC=1

# Sync server URL (overridable per-user later). Default: http://localhost:8080
# VITE_OLLU_SERVER=https://api.ollu.example.com

# Google OAuth Web client ID for login. Register an "OAuth 2.0 Client ID"
# (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add this app's origin (plus http://localhost:5173) to authorised origins
# and redirect URIs. Leave empty to disable Google auth (sync stays offline-only).
# VITE_OLLU_GOOGLE_CLIENT_ID=
